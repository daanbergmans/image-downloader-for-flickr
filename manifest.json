{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "version": "1.3.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Daan",
  "browser_specific_settings": {
    "gecko": {
      "id": "largest-flickr-downloader@daan",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "downloads",
    "menus",
    "notifications",
    "*://*.flickr.com/*",
    "*://api.flickr.com/*",
    "*://*.staticflickr.com/*"
  ],
  "background": {
    "scripts": [
      "lib.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/toolbar-dark-16.png",
      "32": "icons/toolbar-dark-32.png"
    },
    "theme_icons": [
      {
        "light": "icons/toolbar-light-16.png",
        "dark": "icons/toolbar-dark-16.png",
        "size": 16
      },
      {
        "light": "icons/toolbar-light-32.png",
        "dark": "icons/toolbar-dark-32.png",
        "size": 32
      }
    ],
    "default_area": "navbar"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_commandDescription__"
    }
  }
}